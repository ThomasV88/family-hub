          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "pcs",
              "pack",
              "bunch",
              "tbsp",
              "tsp",
              null
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "original": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string"
      }
    }
