APP_NAME="Family Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=family_hub
DB_USERNAME=fh_app
DB_PASSWORD=fh_app_dev
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=



MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Dev only: migrations run as the owner role (DDL) via one-shot commands:
# docker compose run --rm -e DB_USERNAME=fh_owner -e DB_PASSWORD=fh_owner_dev app php artisan migrate
# MIGRATE_DB_USERNAME=fh_owner
# MIGRATE_DB_PASSWORD=fh_owner_dev

# Google sign-in (empty = hidden). Set at go-live, plan 10.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (VAPID). Generate per environment with `php artisan push:vapid`; never commit values.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Passkeys (second factor). SECURITY_PASSKEYS_ENABLED=false switches every passkey route off (404).
# Relying party id and origin come from APP_URL per environment; override only if they must differ
# (PASSKEYS_RP_ID, PASSKEYS_ALLOWED_ORIGINS as a comma list). Set a dedicated, stable user handle secret
# per environment (never reuse across staging and production; do not rotate it once passkeys exist).
SECURITY_PASSKEYS_ENABLED=true
PASSKEYS_USER_HANDLE_SECRET=

# Google as a "Confirm it's you" method for Google-only members (no password, no second factor). Default off:
# only enable after deciding that a Google session counts as proof of identity.
SECURITY_GOOGLE_REAUTH=false
