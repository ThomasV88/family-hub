# Server config rendered by the official nginx image (envsubst) at container start.
# Variables: APP_DOMAIN, NGINX_PROXY_PROTOCOL (proxy_protocol), STACK_ENV (staging|production).
# TLS terminates here with the stack's own Let's Encrypt certificate; the edge only passes TLS through (SNI).

# noindex on staging only; an empty value makes add_header skip the header (production).
map "${STACK_ENV}" $fh_robots {
    staging "noindex, nofollow";
    default "";
}

server {
    listen 443 ssl ${NGINX_PROXY_PROTOCOL};
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:2m;
    ssl_session_timeout 1h;

    # The edge forwards the TLS stream with PROXY protocol, so the PROXY address is the Cloudflare node, not
    # the visitor. Cloudflare puts the visitor in CF-Connecting-IP (inside TLS, readable only here) and the
    # Hetzner firewall admits 443 only from Cloudflare. Trust that header only from the edge hop. The result
    # is used for logs and throttling, never for authorization.
    set_real_ip_from 10.250.250.0/24;
    real_ip_header CF-Connecting-IP;

    set $fh_https on;
    set $fh_proto https;
    set $fh_port 443;

    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/laravel-locations.conf;
}

# Container healthcheck only; not reachable through the edge alias (edge forwards 443).
server {
    listen 8081;
    access_log off;
    location = /nginx-health {
        return 200 "ok\n";
    }
}
