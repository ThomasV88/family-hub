# Environment of the DEV ai-worker only (compose.yaml, profile "ai"). Dev values, no secrets.
# The dev ai-worker must not receive the full .env: no APP_KEY, MAIL_*, GOOGLE_*, VAPID_*, *_API_KEY.
# ai:preflight refuses to start when one is set, so dev exercises the same isolation as production.
APP_ENV=local
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=family_hub
DB_USERNAME=fh_app
DB_PASSWORD=fh_app_dev
CACHE_STORE=database
