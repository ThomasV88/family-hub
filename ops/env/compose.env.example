# Compose interpolation and deploy.sh only. No credentials here (deploy.sh refuses them).
COMPOSE_PROJECT_NAME=family-hub-staging
EDGE_ALIAS=fh-stage-nginx
APP_DOMAIN=family-hub-stage.vostack.dev
IMAGE_PREFIX=ghcr.io/thomasv88/family-hub
# staging or production
STACK_ENV=staging
# 1 only on the staging stack: wipes and reseeds the database on deploy
STAGING_RESEED=0
CERT_EMAIL=owner@example.com
BACKUP_RESTIC_REPOSITORY=/var/backups/restic/family-hub-staging
BACKUP_COPY_REPOSITORY=
MEM_POSTGRES=192m
MEM_APP=192m
MEM_WORKER=160m
MEM_SCHEDULER=128m
MEM_NGINX=48m
