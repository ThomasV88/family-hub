# Laravel runtime for app, worker and scheduler. Runtime role fh_app only.
APP_NAME="Family Hub"
# staging or production
APP_ENV=staging
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://family-hub-stage.vostack.dev
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=family_hub
DB_USERNAME=fh_app
DB_PASSWORD=CHANGE_ME
SESSION_DRIVER=database
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# Mail: staging keeps the log driver (nothing is sent). Production switches to smtp at go-live.
MAIL_MAILER=log
# MAIL_SCHEME=smtps
# MAIL_HOST=mail.vostack.dev
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=CHANGE_ME
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="Family Hub"

# Google sign-in (empty = hidden). Set at go-live, plan 10.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (VAPID). Generate per environment with `php artisan push:vapid`; never commit values.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
