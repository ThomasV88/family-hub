# Environment of the ai-worker service only (never app.env). Runtime role fh_app, queue and database access.
# No APP_KEY, MAIL_*, GOOGLE_*, VAPID_*, AWS_*, STRIPE_*, *_API_KEY, *_SECRET: ai:preflight refuses to start if one is set
# (APP_KEY through config, the others by variable name; it prints problem codes only).
# Never set GH_TOKEN, GITHUB_TOKEN, GH_ENTERPRISE_TOKEN, GITHUB_ENTERPRISE_TOKEN, COPILOT_GITHUB_TOKEN, COPILOT_PROVIDER_*, COPILOT_ALLOW_ALL or COPILOT_OFFLINE:
# they override the subscription login (per-token billing) or change the CLI's trust model.
# staging or production
APP_ENV=staging
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=family_hub
DB_USERNAME=fh_app
DB_PASSWORD=CHANGE_ME
QUEUE_CONNECTION=database
# Must exceed the queue:work --timeout (720) so a running job is never redelivered
DB_QUEUE_RETRY_AFTER=900
# Empty = the Codex default model
AI_CODEX_MODEL=
AI_WORK_DIR=/ai-work
